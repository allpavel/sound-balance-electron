{
	"name": "sound-balance-electron",
	"version": "0.1.0",
	"description": "An Electron application for sound normalizing",
	"main": "./out/main/index.js",
	"author": "Pavel Alloyarov",
	"license": "GPL-3.0-or-later",
	"scripts": {
		"typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
		"typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
		"typecheck": "npm run typecheck:node && npm run typecheck:web",
		"start": "electron-vite preview",
		"dev": "electron-vite dev",
		"build": "npm run typecheck && electron-vite build",
		"postinstall": "electron-builder install-app-deps",
		"build:unpack": "npm run build && electron-builder --dir",
		"build:win": "npm run build && electron-builder --win",
		"build:mac": "npm run build && electron-builder --mac",
		"build:linux": "npm run build && electron-builder --linux",
		"test": "vitest run --silent=passed-only"
	},
	"dependencies": {
		"@electron-toolkit/preload": "^3.0.2",
		"@electron-toolkit/utils": "^4.0.0",
		"@mantine/core": "^9.5.1",
		"@mantine/form": "^9.5.1",
		"@mantine/hooks": "^9.5.1",
		"@reduxjs/toolkit": "^2.12.0",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-router": "^1.170.23",
		"@tanstack/react-store": "^0.11.1",
		"@tanstack/react-table": "^9.0.1",
		"@testing-library/jest-dom": "^7.0.1",
		"dexie": "^4.4.4",
		"dexie-react-hooks": "^4.4.0",
		"ffmpeg-static": "^5.3.0",
		"jsdom": "^29.1.1",
		"lucide-react": "^1.30.0",
		"music-metadata": "^11.14.0",
		"p-queue": "^9.3.3",
		"react-redux": "^9.3.0",
		"sonner": "^2.0.7",
		"uuid": "^14.0.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@electron-toolkit/tsconfig": "^2.0.0",
		"@tanstack/router-plugin": "^1.168.27",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^26.1.2",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"commitizen": "^4.3.2",
		"cz-conventional-changelog": "^3.3.0",
		"electron": "42.3.3",
		"electron-builder": "^26.15.7",
		"electron-vite": "^5.0.0",
		"fake-indexeddb": "^6.2.5",
		"lefthook": "^2.1.10",
		"postcss": "^8.5.26",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"typescript": "^6.0.3",
		"vite": "^8.2.1",
		"vitest": "^4.1.9"
	},
	"overrides": {
		"vite": "$vite",
		"@vitejs/plugin-react": "$@vitejs/plugin-react",
		"lodash": "4.18.1"
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"electron-winstaller@5.4.0": true,
		"ffmpeg-static@5.3.0": true,
		"lefthook@2.1.10": true,
		"electron@43.3.0": true
	}
}
