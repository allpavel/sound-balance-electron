{
	"name": "sound-balance-electron",
	"version": "0.1.0",
	"description": "An Electron application for sound normalizing",
	"main": "./out/main/index.js",
	"author": "Pavel Alloyarov",
	"license": "GPL-3.0-or-later",
	"scripts": {
		"typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
		"typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
		"typecheck": "npm run typecheck:node && npm run typecheck:web",
		"start": "electron-vite preview",
		"dev": "electron-vite dev",
		"build": "npm run typecheck && electron-vite build",
		"postinstall": "electron-builder install-app-deps",
		"build:unpack": "npm run build && electron-builder --dir",
		"build:win": "npm run build && electron-builder --win",
		"build:mac": "npm run build && electron-builder --mac",
		"build:linux": "npm run build && electron-builder --linux",
		"test": "vitest run --silent=passed-only",
		"test:coverage": "vitest run --coverage --silent=passed-only",
		"test:shuffle": "vitest run --sequence.shuffle --silent=passed-only"
	},
	"dependencies": {
		"@electron-toolkit/preload": "^3.0.2",
		"@electron-toolkit/utils": "^4.0.0",
		"@mantine/core": "^9.7.4",
		"@mantine/form": "^9.7.4",
		"@mantine/hooks": "^9.7.4",
		"@reduxjs/toolkit": "^2.13.0",
		"@tanstack/react-query": "^5.105.1",
		"@tanstack/react-router": "^1.170.46",
		"@tanstack/react-store": "^0.11.2",
		"@tanstack/react-table": "^9.3.1",
		"@testing-library/jest-dom": "^7.0.1",
		"dexie": "^4.4.7",
		"dexie-react-hooks": "^4.4.0",
		"ffmpeg-static": "^5.3.0",
		"jsdom": "^30.1.3",
		"lucide-react": "^1.66.0",
		"music-metadata": "^12.3.3",
		"p-queue": "^9.3.3",
		"react-redux": "^9.3.1",
		"sonner": "^2.0.8",
		"uuid": "^14.0.3",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@electron-toolkit/tsconfig": "^2.0.0",
		"@tanstack/router-plugin": "^1.168.48",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.2.1",
		"commitizen": "^4.3.2",
		"cz-conventional-changelog": "^3.3.0",
		"electron": "42.3.3",
		"electron-builder": "^26.18.0",
		"electron-vite": "^6.0.0",
		"fake-indexeddb": "^6.2.7",
		"lefthook": "^2.2.2",
		"postcss": "^8.5.32",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"overrides": {
		"vite": "$vite",
		"@vitejs/plugin-react": "$@vitejs/plugin-react",
		"lodash": "4.18.1"
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"electron-winstaller@5.4.0": true,
		"ffmpeg-static@5.3.0": true,
		"lefthook@2.1.10": true,
		"electron@43.3.0": true
	}
}
